{
    "schemaVersion": 1,
    "id": "oblivion_api",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "homepage": "${homepage}",
        "sources": "${homepage}",
        "issues": "${homepage}/issues"
    },
    "license": "${license}",
    "icon": "icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
          "com.github.voidleech.oblivion.OblivionFabric"
        ],
        "client": [
            "com.github.voidleech.oblivion.OblivionFabricClient"
        ]
    },
    "mixins": [
        "${mod_id}.mixins.json",
        "${mod_id}.fabric.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric": "*",
        "minecraft": "${minecraft_version}",
        "java": ">=17",
        "porting_lib_brewing": ">=${porting_lib_version}"
    },
    "suggests": {
        "jade": ">=${jade_version}"
    },
    "custom": {
        "modmenu": {
            "badges": [ "library" ]
        }
    }
}
  